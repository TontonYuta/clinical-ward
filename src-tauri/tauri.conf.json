{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ClinicalWard",
  "version": "1.0.0",
  "identifier": "com.clinicalward.hospital",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Clinical Ward - Trạm Lâm Sàng Thông Minh Bệnh Viện",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
