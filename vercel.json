{
  "functions": {
    "api/*.py": {
      "excludeFiles": "{docs/**,public/**,TEMP/**,backend/data/knowledge_base/*.pdf,**/*.mp4,**/*.png,**/*.jpg}"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/pdf/(.*)",
      "destination": "/pdf/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
