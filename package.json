{
  "name": "clinical-ward",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:full",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:kb": "tsx scripts/verify_clinical_knowledge_base.ts",
    "validate:sources": "python3 scripts/validate_clinical_sources.py",
    "test:chatbot": "tsx scripts/test_chatbot_suite.ts",
    "test": "tsx scripts/test_chatbot_suite.ts && tsx scripts/verify_clinical_knowledge_base.ts && tsx tests/test_clinical_formatter.ts && tsx tests/test_ddi_algorithm.ts && tsx tests/test_disable_devtool_gate.ts && tsx tests/test_operations_overview_navigation.ts && tsx tests/test_operations_overview_model.ts && tsx tests/test_flat_dashboard_model.ts && tsx tests/test_font_scale_model.ts && tsx tests/test_patient_lookup_logic.ts && tsx tests/test_offline_registry_search.ts && tsx tests/test_pdf_files_integrity.ts && tsx tests/test_voice_input_and_clean_ui.ts",
    "dev:full": "python3 scripts/run_dev_stack.py",
    "dev:api": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:web": "vite --port=3000 --host=0.0.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "disable-devtool": "^0.3.9",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
