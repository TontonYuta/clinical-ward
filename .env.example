GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional internal authentication. Keep false for local demo mode only.
# When true, generate password hashes with:
#   .venv/bin/python -c "from app.security.auth import hash_password; print(hash_password('REPLACE_ME'))"
# Then set AUTH_USERS_JSON to a JSON object such as:
# {"alice":{"role":"pharmacist","password_hash":"pbkdf2_sha256$..."}}
AUTH_REQUIRED="false"
AUTH_USERS_JSON="{}"
AUTH_TOKEN_TTL_SECONDS="3600"
SECRET_KEY=""
